---
import { useStoryblokApi } from "@storyblok/astro";

import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { getStoryblokVersion } from "../utils/storyblok";

const sbApi = useStoryblokApi();
const { data } = await sbApi.get("cdn/stories/home", {
  version: getStoryblokVersion(Astro.request),
});

const metadata = {
  siteTitle: "Seaside Heritage Network",
  pageTitle: "Home",
  description:
    "Discover the rich heritage of seaside tourism and its unique architectural legacy with the Seaside Heritage Network.",
};

const story = data.story;
---

<PageLayout metadata={metadata}>
  <StoryblokComponent blok={story.content} />
</PageLayout>
