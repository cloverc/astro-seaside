---
import { useStoryblokApi } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import PageLayout from "../layouts/PageLayout.astro";

const { slug } = Astro.params;

const storyblokApi = useStoryblokApi();

let story: any;
try {
  const { data } = await storyblokApi.get(
    `cdn/stories/${slug === undefined ? "home" : slug}`,
    {
      version: (() => {
        const host = Astro.request.headers.get("host") ?? "";
        return host.includes("preview--") || host.includes("localhost")
          ? "draft"
          : "published";
      })(),
    },
  );
  story = data.story;
} catch (e) {
  return Astro.redirect("/404");
}

const baseName = story.name === undefined ? "Home" : story.name;
const pageParam = parseInt(Astro.url.searchParams.get("page") ?? "1");
const metadata = {
  siteTitle: "Seaside Heritage Network",
  pageTitle: pageParam > 1 ? `${baseName} (page ${pageParam})` : baseName,
};
---

<PageLayout metadata={metadata}>
  <StoryblokComponent blok={story.content} />
</PageLayout>
