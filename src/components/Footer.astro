---
import SocialLinks from "./SocialLinks.astro";
import pilgrimGreen from "../assets/images/Pilgrim_Trust_logo_green.svg";

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  socialLinks: Array<Link>;
  footNote?: string;
}

const { socialLinks = [], links = [], footNote = "" } = Astro.props;
---

<footer class="text-dark font-serif">
  <!-- Main section: logo, nav links, social icons -->
  <div class="bg-white border-t border-gray-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 md:py-12">
      <div class="grid grid-cols-12 gap-8 items-start">
        {
          links.map(({ title, links: items }) => (
            <div class="col-span-12 md:col-span-3">
              {title && <p class="font-semibold mb-3">{title}</p>}
              {items && items.length > 0 && (
                <ul class="space-y-2">
                  {items.map(({ text, href, ariaLabel }) => (
                    <li>
                      <a
                        class="text-sm hover:underline transition duration-150 ease-in-out"
                        href={href}
                        aria-label={ariaLabel}
                      >
                        <Fragment set:html={text} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }

        <div class="col-span-12 md:col-span-3">
          <p class="text-xs text-gray-500 mb-2">Supported by</p>
          <a
            href="https://www.thepilgrimtrust.org.uk/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="The Pilgrim Trust (opens in a new tab)"
          >
            <img
              src={pilgrimGreen.src}
              width="136"
              height="70"
              decoding="async"
              alt="The Pilgrim Trust"
              class="h-14 w-auto"
            />
          </a>
        </div>

        <div class="col-span-12 md:col-span-3 md:flex md:justify-end">
          <SocialLinks
            links={socialLinks}
            variant="gray"
            class="flex flex-row flex-wrap gap-1"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright band -->
  <div class="bg-gray-100 border-t border-gray-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-4">
      <p class="text-xs text-gray-600">
        <Fragment set:html={footNote} />
      </p>
    </div>
  </div>
</footer>
