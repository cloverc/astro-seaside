---
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import SocialLinks from "./SocialLinks.astro";
import ToggleMenu from "./ToggleMenu.astro";

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  socialLinks?: Array<MenuLink>;
  isSticky?: boolean;
  isFullWidth?: boolean;
  showSocialIcons?: boolean;
  position?: string;
}

const {
  id = "header",
  links = [],
  socialLinks = [],
  isSticky = false,
  isFullWidth = false,
  position = "center",
} = Astro.props;

const currentPath = `/${new URL(Astro.url).pathname}`;
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky },
    "top-0 z-40 flex-none mx-auto w-full transition-[opacity] ease-in-out scroll",
  ]}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      "relative text-default py-4 px-4 lg:py-5 lg:px-6 mx-auto w-full flex flex-col lg:flex-row lg:items-center",
      {
        "max-w-7xl": !isFullWidth,
      },
    ]}
  >
    <div
      class:list={[
        { "mr-auto rtl:mr-0 rtl:ml-auto": position === "right" },
        "flex justify-between",
      ]}
    >
      <a
        class="flex items-center"
        href="/"
        aria-label="Seaside Heritage Network home"
      >
        <Logo />
      </a>
      <div class="flex items-center lg:hidden">
        <ToggleMenu />
      </div>
    </div>
    <nav
      class="items-center w-full lg:w-auto hidden lg:flex text-default overflow-y-auto overflow-x-hidden lg:overflow-visible lg:ml-auto"
      aria-label="Main navigation"
    >
      <ul
        class="flex flex-col lg:flex-row lg:self-center w-full lg:w-auto text-xl lg:text-[0.95rem] tracking-[0.01rem] font-sans font-medium border-t border-white/20 lg:border-none"
      >
        {
          links.map(({ text, href, links: sublinks }, index) => (
            <li
              class:list={[
                sublinks?.length ? "dropdown" : "",
                "border-b border-white/20 lg:border-none",
              ]}
            >
              {sublinks?.length ? (
                <>
                  <button
                    class="hover:text-link px-4 py-6 lg:py-3 flex items-center w-full justify-between lg:w-auto lg:justify-start"
                    aria-expanded="false"
                    aria-controls={`nav-dropdown-${index}`}
                  >
                    {text}
                    <Icon
                      name="tabler:chevron-down"
                      class="w-6 h-6 lg:w-3.5 lg:h-3.5 ml-2 lg:ml-0.5 text-white lg:text-current transition-transform duration-200"
                      aria-hidden="true"
                    />
                  </button>
                  <ul
                    id={`nav-dropdown-${index}`}
                    class="dropdown-menu lg:bg-page lg:border rounded lg:absolute pl-4 lg:pl-2 pb-4 lg:pb-2 lg:pt-2 hidden font-medium lg:min-w-[200px]"
                  >
                    {sublinks.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          aria-current={
                            href2 === currentPath ? "page" : undefined
                          }
                          class:list={[
                            "first:rounded-t px-2 last:rounded-b underline hover:decoration-2 py-1.5 block",
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  aria-current={href === currentPath ? "page" : undefined}
                  class:list={[
                    "hover:text-link hover:underline transition duration-150 ease-in-out px-4 py-6 lg:py-3 flex items-center w-full lg:w-auto",
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
