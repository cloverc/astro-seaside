---
import { Icon } from "astro-icon/components";
import RelatedCard from "./RelatedCard.astro";
import type { RelatedContentKind } from "../utils/relatedContent";

interface RelatedItem {
  kind: RelatedContentKind;
  title: string;
  summary: string;
  meta: string;
  href: string;
  image: { filename: string; alt: string };
  badgeColor?: string;
  badgeLabel?: string;
}

type Context = "article" | "resource" | "event" | "latest-news";

interface Props {
  items: RelatedItem[];
  context: Context;
  theme?: "dark" | "light";
  heading?: string;
  viewAll?: boolean;
  maxWidth?: string;
  padding?: string;
  outerPadding?: string;
  cardMinWidth?: string;
}

const {
  items,
  context,
  theme = "dark",
  heading,
  viewAll = true,
  maxWidth = "max-w-7xl",
  padding = "px-6",
  outerPadding = "",
  cardMinWidth = "300px",
} = Astro.props;

const innerClass = `${maxWidth} mx-auto ${padding}`;

const contextDefaults: Record<
  Context,
  { heading: string; viewAllLabel: string; viewAllHref: string }
> = {
  article: {
    heading: "Related reading",
    viewAllLabel: "Browse news & insights",
    viewAllHref: "/news-and-insights",
  },
  resource: {
    heading: "More like this",
    viewAllLabel: "Browse the Resource Hub",
    viewAllHref: "/resource-hub",
  },
  event: {
    heading: "Before you go",
    viewAllLabel: "Browse events",
    viewAllHref: "/events",
  },
  "latest-news": {
    heading: "Latest News & Insights",
    viewAllLabel: "Browse news & insights",
    viewAllHref: "/news-and-insights",
  },
};

const defaults = contextDefaults[context];
const resolvedHeading = heading ?? defaults.heading;

const sectionBg = theme === "dark" ? "bg-page" : "bg-muted";
const headingText =
  theme === "dark" ? "text-white" : "text-[var(--shn-color-bg-page)]";
const linkText =
  theme === "dark"
    ? "text-white hover:text-secondary hover:underline active:underline"
    : "text-[var(--shn-color-primary)] hover:text-[var(--shn-color-bg-page)] hover:underline active:underline";
---

{
  items.length > 0 && (
    <section aria-labelledby="related-content-heading" class={sectionBg}>
      <div class={`${outerPadding} py-14 sm:py-16`}>
        <div class={innerClass}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 mb-7">
            <h2
              id="related-content-heading"
              class={`font-heading font-semibold text-[2rem] md:text-3xl lg:text-4xl ${headingText}`}
            >
              {resolvedHeading}
            </h2>
            {viewAll && (
              <a
                href={defaults.viewAllHref}
                class={`inline-flex items-center gap-2 font-semibold min-h-11 ${linkText}`}
              >
                {defaults.viewAllLabel}
                <Icon
                  name="tabler:arrow-right"
                  class="w-[18px] h-[18px]"
                  aria-hidden="true"
                />
              </a>
            )}
          </div>

          <div
            class="grid gap-6"
            style={`grid-template-columns: repeat(auto-fill, minmax(min(100%, ${cardMinWidth}), 1fr));`}
          >
            {items.map((item) => (
              <RelatedCard item={item} theme={theme} />
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
