<style is:inline is:global>
  :root {
    --shn-font-sans: "Inter";
    --shn-font-serif: "Kameron";
    --shn-font-heading: var(--shn-font-serif);

    --shn-color-primary: rgb(30 64 175);
    --shn-color-secondary: rgb(65, 150, 204);
    --shn-color-accent: rgb(223 22 122);
    --shn-color-accent-hover: rgb(236 72 153);

    --shn-color-text-default: rgb(255 255 255);
    --shn-color-text-dark: rgb(42 42 48);
    --shn-color-text-muted: rgb(255 255 255 / 0.65);
    --shn-color-bg-card: var(--shn-color-primary);
    --shn-color-bg-page: rgb(12 5 109);
    --shn-color-bg-muted: rgb(235 238 240);

    --focus-ring-color: rgb(255 255 255);
    --focus-ring-offset: 3px;
    --focus-ring-style: solid;
    --focus-ring-width: 2px;
  }
</style>
