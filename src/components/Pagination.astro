---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;

function pageHref(page: number) {
  return page === 1 ? basePath : `${basePath}?page=${page}`;
}

function pageRange(current: number, total: number): (number | "...")[] {
  const show = new Set([1, total, current]);
  if (current > 1) show.add(current - 1);
  if (current < total) show.add(current + 1);

  const sorted = Array.from(show).sort((a, b) => a - b);
  const result: (number | "...")[] = [];

  for (let i = 0; i < sorted.length; i++) {
    if (i > 0) {
      const gap = sorted[i] - sorted[i - 1];
      if (gap === 2) result.push(sorted[i - 1] + 1);
      else if (gap > 2) result.push("...");
    }
    result.push(sorted[i]);
  }

  return result;
}

const pages = pageRange(currentPage, totalPages);

const linkClass =
  "inline-flex items-center justify-center px-3 py-2 font-medium underline decoration-1 hover:decoration-2";
const currentClass =
  "inline-flex items-center justify-center w-10 h-10 font-bold bg-accent text-white";
const pageClass =
  "inline-flex items-center justify-center w-10 h-10 font-medium underline decoration-1 hover:decoration-2";
---

<nav
  aria-label="Pagination"
  class="flex flex-col sm:flex-row sm:flex-wrap items-center justify-center gap-3 pt-0 pb-10"
>
  {
    currentPage > 1 && (
      <a
        href={pageHref(currentPage - 1)}
        rel="prev"
        class={linkClass}
        aria-label="Previous page"
      >
        &larr; Previous
      </a>
    )
  }

  <div class="flex items-center gap-1">
    {
      pages.map((page) =>
        page === "..." ? (
          <span class="px-2 text-muted-foreground" aria-hidden="true">
            &hellip;
          </span>
        ) : (
          <a
            href={pageHref(page)}
            aria-label={`Page ${page}`}
            aria-current={page === currentPage ? "page" : undefined}
            class={page === currentPage ? currentClass : pageClass}
          >
            {page}
          </a>
        ),
      )
    }
  </div>

  {
    currentPage < totalPages && (
      <a
        href={pageHref(currentPage + 1)}
        rel="next"
        class={linkClass}
        aria-label="Next page"
      >
        Next &rarr;
      </a>
    )
  }
</nav>
