---
import Link from "../components/Link.astro";
import { Icon } from "astro-icon/components";

const {
  href = "https://73f8e550.sibforms.com/serve/MUIFAAI3KexSuXDCXbHcFlQuvima5JyksHZa4JqIsxnL2fOWTOA38G_EuMVTGwrEpHMA4yxSbgJtlk4MPGuR99ojNNY3MmkubSVWkWvd_kDm450oqBCl-9ddBnsxowvWauT8Ur6hwr03DMw01UgiYzq-733gk6ycW235jTuAhX8ZJHD0oQ8EMo-4-xVWIVeVLRFnXUbcZvq2OfQf",
} = Astro.props;
---

<section class="mx-auto lg:py-20 px-6 py-12 sm:py-16">
  <div class="max-w-3xl mx-auto text-center p-10 rounded-md shadow-xl border">
    <Icon
      name="tabler:mail"
      class="w-10 h-10 inline-block -mt-1"
      aria-hidden="true"
    />
    <h2
      class="text-2xl md:text-3xl lg:text-4xl font-heading font-semibold pb-4 [text-wrap:balance]"
    >
      Sign up to our Newsletter
    </h2>
    <p class="mb-6 [text-wrap:pretty]">
      Discover all the latest from the Seaside Heritage Network, direct to your
      inbox.
    </p>
    <Link href={href}> Sign Up </Link>
  </div>
</section>
