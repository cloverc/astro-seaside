---
import { useStoryblokApi } from "@storyblok/astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getStoryblokVersion } from "../utils/storyblok";

const storyblokApi = useStoryblokApi();

const { data } = await storyblokApi.get("cdn/stories/", {
  version: getStoryblokVersion(Astro.request),
  starts_with: "events/upcoming-events",
  is_startpage: false,
  per_page: 2,
});

const articles = data.stories;
---

<section class="mx-auto pt-12 sm:pt-16 pb-16 sm:pb-20 bg-page">
  <div
    class="grid mx-auto px-6 gap-12 md:grid-cols-2 md:gap-12 lg:grid-cols-3 max-w-7xl"
  >
    <div>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-heading font-semibold">
        Upcoming Events
      </h2>
      <p class="leading-relaxed line-clamp-4 my-4">
        Take a look at the Seaside Heritage Network's upcoming events and book
        your place.
      </p>
    </div>
    {
      articles.length ? (
        articles?.map((article: any) => {
          return (
            <ArticleCard event={article.content} slug={article.full_slug} />
          );
        })
      ) : (
        <div>
          <p>No upcoming events right now.</p>
          <p class="mt-2">
            <a class="underline hover:decoration-2" href="/events/past-events/">
              Browse past events
            </a>{" "}
            or check back soon.
          </p>
        </div>
      )
    }
  </div>
</section>
