---
import { storyblokEditable, useStoryblokApi } from "@storyblok/astro";
import HeroText from "../components/HeroText.astro";
import TeamMember from "./TeamMember.astro";
import { getStoryblokVersion } from "../utils/storyblok";

const { blok } = Astro.props;
const storyblokApi = useStoryblokApi();

const { data } = await storyblokApi.get("cdn/stories", {
  version: getStoryblokVersion(Astro.request),
  starts_with: "team/",
  is_startpage: false,
  sort_by: "position:asc",
});

const team = data ? data.stories : [];
---

<section
  class="mx-auto sm:px-6 lg:py-12 max-w-6xl px-6 pb-12 sm:pb-16"
  {...storyblokEditable(blok)}
>
  <HeroText tagline="About" title="Meet the Trustees" />
  <p class="mb-8 md:text-lg">The Seaside Heritage Network has 5 Trustees</p>
  <div
    class="grid mx-auto place-items-top gap-6 md:grid-cols-2 md:gap-8 lg:grid-cols-3 max-w-6xl"
  >
    {
      team?.length &&
        team.map((team_member: any, index: number) => {
          team_member.content.slug = team_member.slug;
          return (
            <TeamMember
              member={team_member.content}
              slug={team_member.slug}
              isFirst={index === 0}
            />
          );
        })
    }
  </div>
</section>
