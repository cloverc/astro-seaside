---
import { useStoryblokApi } from "@storyblok/astro";
import RelatedContent from "../components/RelatedContent.astro";
import { getStoryblokVersion } from "../utils/storyblok";
import { kindFromStory } from "../utils/relatedContent";

const { blok } = Astro.props;

const storyblokApi = useStoryblokApi();
const version = getStoryblokVersion(Astro.request);

// Resource items 404 until Resource Hub ships, so only mix them into
// What's New once the flag that gates their pages is actually on.
const resourceHubEnabled =
  import.meta.env.PUBLIC_RESOURCE_HUB_ENABLED === "true";
const components = resourceHubEnabled ? "article,resource_item" : "article";

let stories: any[] = [];
try {
  const { data } = await storyblokApi.get("cdn/stories", {
    version,
    filter_query: {
      component: { in: components },
    },
    sort_by: "content.published_date:desc",
    per_page: 3,
  });
  stories = data.stories ?? [];
} catch {
  // leave empty
}

const items = stories.map((story: any) => {
  const c = story.content;
  const kind = kindFromStory(story);
  const isResource = kind === "resource";
  return {
    kind,
    title: c.title ?? "",
    summary: (isResource ? c.description : c.summary) ?? "",
    meta: c.published_date
      ? new Date(c.published_date).toLocaleDateString("en-GB", {
          day: "numeric",
          month: "short",
          year: "numeric",
        })
      : "",
    href: isResource
      ? `/resource-hub/${story.slug}`
      : `/news-and-insights/${story.slug}/`,
    image: {
      filename: (isResource ? c.featured_image : c.hero_image)?.filename ?? "",
      alt: (isResource ? c.featured_image : c.hero_image)?.alt ?? "",
    },
  };
});
---

<RelatedContent
  context="latest-news"
  theme="dark"
  heading={blok.heading || "What's New"}
  items={items}
/>
