---
import { Icon } from "astro-icon/components";
import HeroText from "../components/HeroText.astro";
import { storyblokEditable } from "@storyblok/astro";

const { blok } = Astro.props;
---

<section class="mx-auto lg:py-12 pb-12 sm:pb-16" {...storyblokEditable(blok)}>
  <HeroText tagline="About" title="Mission and Values" />
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="bg-page p-6 grid gap-6 md:gap-8 md:grid-cols-5">
      <img
        class="object-cover object-[center_25%] w-full rounded max-h-64 md:max-h-none md:col-span-2"
        src={`${blok.image.filename}/m/460x0/filters:quality(70):format(webp)`}
        srcset={`
        ${blok.image.filename}/m/400x0/filters:quality(70):format(webp) 400w,
        ${blok.image.filename}/m/460x0/filters:quality(70):format(webp) 460w,
        ${blok.image.filename}/m/920x0/filters:quality(70):format(webp) 920w
      `}
        sizes="auto, (max-width: 767px) 100vw, 50vw"
        width="460"
        height="600"
        loading="lazy"
        decoding="async"
        alt={blok.image.alt}
      />
      <div class="w-full px-0 md:col-span-3">
        <div class="mx-auto max-w-3xl space-y-4 md:text-lg">
          <p>
            The Seaside Heritage Network is an educational charity which acts to
            raise awareness and understanding of the distinctive heritage of the
            UK seaside holiday. This heritage is both tangible and intangible –
            it comprises the historical architecture, social and cultural
            history, and everyday practices associated with 19th and 20th
            century mass tourism to UK seaside towns.
          </p>
          <p>
            Our position is that the heritage created by mass tourism at the
            seaside is highly distinctive and has importance for many visitors
            at the seaside. At the same time, it is a heritage that is
            frequently overlooked and often neglected by many heritage agencies.
            We seek to raise the profile of seaside heritage and celebrate its
            unique contribution to life in this country.
          </p>
        </div>
      </div>
    </div>
  </div>
  <div
    class="mx-auto relative px-4 lg:py-12 md:px-6 pt-12 sm:pt-16 pb-12 sm:pb-16 md:text-lg text-default max-w-5xl"
  >
    <h2
      class="text-2xl md:text-3xl font-heading font-semibold mb-4 lg:text-4xl"
    >
      Our Formal Charitable Objectives
    </h2>
    <p class="mb-8 md:text-lg">
      To advance the education of the public in the subject of seaside heritage
      by:
    </p>

    <ol class="space-y-6">
      <li class="flex gap-4">
        <Icon
          name="tabler:circle-letter-a"
          class="w-7 h-7 shrink-0 text-white mt-0.5"
          aria-hidden="true"
        />
        <span>
          Providing regular educational activities open to the public (including
          seminars, lectures, symposia, workshops, and guided walks) that build
          knowledge and understanding of the distinctive heritage of seaside
          towns
        </span>
      </li>
      <li class="flex gap-4">
        <Icon
          name="tabler:circle-letter-b"
          class="w-7 h-7 shrink-0 text-white mt-0.5"
          aria-hidden="true"
        />
        <span>
          Facilitating a public network (that includes academics, historians,
          third sector campaign groups, building preservation trusts, civic
          trusts, owners of historic buildings, museums and members of the
          public) to promote knowledge and understanding of the detail and
          significance of seaside heritage
        </span>
      </li>
      <li class="flex gap-4">
        <Icon
          name="tabler:circle-letter-c"
          class="w-7 h-7 shrink-0 text-white mt-0.5"
          aria-hidden="true"
        />
        <span>
          Sharing ideas and resources to promote best practice in the
          recognition, understanding and protection of seaside heritage for the
          public benefit
        </span>
      </li>
      <li class="flex gap-4">
        <Icon
          name="tabler:circle-letter-d"
          class="w-7 h-7 shrink-0 text-white mt-0.5"
          aria-hidden="true"
        />
        <span>
          Conducting, supporting and sharing publicly-accessible research into
          the history and culture of seaside towns, including establishing an
          online resource hub.
        </span>
      </li>
    </ol>
  </div>
</section>
