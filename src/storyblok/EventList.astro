---
import { storyblokEditable, useStoryblokApi } from "@storyblok/astro";
import EventItem from "../components/EventItem.astro";
import HeroText from "../components/HeroText.astro";
import Pagination from "../components/Pagination.astro";
import { filterAndSortEvents } from "../utils/filterEvents";
import { getStoryblokVersion } from "../utils/storyblok";

const { blok } = Astro.props;
const storyblokApi = useStoryblokApi();

const currentPath = Astro.url.pathname;
const isPastEvents = currentPath.includes("past-events");

const PER_PAGE = 6;

let events: any[] = [];
let totalPages = 1;
let currentPage = 1;

if (isPastEvents) {
  currentPage = Math.max(
    1,
    parseInt(Astro.url.searchParams.get("page") ?? "1"),
  );

  const { data, headers } = await storyblokApi.get("cdn/stories/", {
    version: getStoryblokVersion(Astro.request),
    starts_with: "events/past-events",
    is_startpage: false,
    per_page: PER_PAGE,
    page: currentPage,
    sort_by: "content.date:desc",
  });

  events = data.stories ?? [];
  totalPages = Math.ceil(
    parseInt((headers as unknown as Record<string, string>).total ?? "0") /
      PER_PAGE,
  );
} else {
  const { data } = await storyblokApi.get("cdn/stories/", {
    version: getStoryblokVersion(Astro.request),
    starts_with: "events/upcoming-events",
    is_startpage: false,
  });

  events = filterAndSortEvents(data.stories, new Date(), true);
}

const pageTitle = isPastEvents ? "Past Events" : "Upcoming Events";
---

<section
  class="mx-auto sm:px-6 lg:py-12 max-w-6xl px-6 pb-12 sm:pb-16"
  {...storyblokEditable(blok)}
>
  <HeroText tagline="What's On" title={pageTitle} />
  <ul>
    {
      events.length ? (
        events.map((event) => (
          <li class="rounded mb-12 md:mb-20 p-6 bg-card">
            <EventItem event={event.content} slug={event.full_slug} />
          </li>
        ))
      ) : (
        <li class="text-center text-lg text-muted-foreground py-10">
          {isPastEvents
            ? "No past events found."
            : "No upcoming events at the moment. Check back soon!"}
        </li>
      )
    }
  </ul>
  {
    isPastEvents && totalPages > 1 && (
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        basePath={currentPath}
      />
    )
  }
</section>
