---
import { storyblokEditable } from "@storyblok/astro";
import { renderRichText } from "@storyblok/astro";

const {
  blok,
  member: memberProp,
  slug: slugProp,
  cardHeadlineTag = "h2",
  isFirst = false,
} = Astro.props;
const member = memberProp ?? blok;

const renderedRichText = member.profile ? renderRichText(member.profile) : null;

const HeadlineTag = cardHeadlineTag;
---

<article
  {...storyblokEditable(member)}
  id={slugProp ?? member.slug ?? undefined}
  class="grid-two-col text-dark scroll-mt-24 lg:scroll-mt-28"
>
  {
    member.profile_picture?.filename ? (
      <div class="rounded overflow-hidden relative aspect-[4/3] bg-stone-300">
        <img
          class="absolute inset-0 w-full h-full object-cover object-center"
          src={`${member.profile_picture.filename}/m/400x300/filters:quality(70):format(webp)`}
          srcset={`
          ${member.profile_picture.filename}/m/400x300/filters:quality(70):format(webp) 400w,
          ${member.profile_picture.filename}/m/600x450/filters:quality(70):format(webp) 600w
        `}
          sizes="(max-width: 767px) 100vw, 50vw"
          width="400"
          height="300"
          loading={isFirst ? "eager" : "lazy"}
          fetchpriority={isFirst ? "high" : "auto"}
          decoding={isFirst ? "sync" : "async"}
          alt={member.profile_picture.alt ?? member.name}
        />
      </div>
    ) : (
      <div class="rounded bg-stone-300 aspect-[4/3]" />
    )
  }
  <div class="py-2">
    <HeadlineTag
      class="text-2xl md:text-3xl font-heading text-accent font-semibold mb-1"
    >
      {member.name}
    </HeadlineTag>
    {
      member.title && (
        <p class="text-base font-semibold mb-3 font-heading">{member.title}</p>
      )
    }
    {
      renderedRichText && (
        <div
          set:html={renderedRichText}
          class="prose prose-sm mb-2 [&_blockquote_p::before]:content-none [&_blockquote_p::after]:content-none"
        />
      )
    }
  </div>
</article>
