---
import { useStoryblokApi } from "@storyblok/astro";
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Newsletter from "../components/Newsletter.astro";
import { getStoryblokVersion } from "../utils/storyblok";

const { metadata } = Astro.props;

const storyblokApi = useStoryblokApi();

const version = getStoryblokVersion(Astro.request);

const [{ data }, { data: homeData }, globalConfigResult] = await Promise.all([
  storyblokApi.get("cdn/stories", {
    version,
    starts_with: "bucket-spade-list",
    is_startpage: true,
  }),
  storyblokApi.get("cdn/stories/home", { version }),
  storyblokApi.get("cdn/stories/global-config", { version }).catch(() => null),
]);

const gc = globalConfigResult?.data?.story?.content ?? {};

const siteUrl = Astro.site?.href ?? "https://seasideheritage.org.uk/";
const orgName = gc.org_name ?? "Seaside Heritage Network";

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: orgName,
      url: siteUrl,
      description:
        "A charity raising awareness and understanding of the broad heritage associated with the UK seaside holiday.",
      inLanguage: "en-GB",
      sameAs: [
        gc.instagram_url ?? "https://www.instagram.com/seaside_network/",
        gc.x_url ?? "https://twitter.com/seaside_network",
        gc.youtube_url ?? "https://www.youtube.com/@SeasideHeritageNetwork",
      ].filter(Boolean),
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: orgName,
      inLanguage: "en-GB",
      publisher: { "@id": `${siteUrl}#organization` },
    },
  ],
};

const bucketPageLinks = data ? data.stories : [];

const sharedSocialLinks = [
  {
    ariaLabel: "Instagram",
    icon: "tabler:brand-instagram",
    href: gc.instagram_url ?? "https://www.instagram.com/seaside_network/",
  },
  {
    ariaLabel: "X",
    icon: "tabler:brand-x",
    href: gc.x_url ?? "https://twitter.com/seaside_network",
  },
  {
    ariaLabel: "YouTube",
    icon: "tabler:brand-youtube",
    href: gc.youtube_url ?? "https://www.youtube.com/@SeasideHeritageNetwork",
  },
];

const latestWinners = bucketPageLinks
  .filter((s: { full_slug: string }) => s.full_slug.includes("top-ten-winners"))
  .sort((a: { full_slug: string }, b: { full_slug: string }) =>
    b.full_slug.localeCompare(a.full_slug),
  )[0];

// Map the Storyblok data to match the header structure for Bucket & Spade List
const bucketHeaderLinks = bucketPageLinks.map(
  (item: { name: string; full_slug: string }) => ({
    text: item.name,
    href: `/${item.full_slug}`,
  }),
);

/** Main menu items */
const headerData = {
  links: [
    {
      text: "Events",
      href: "#",
      links: [
        { text: "Upcoming Events", href: "/events/upcoming-events/" },
        { text: "Past Events", href: "/events/past-events/" },
      ],
    },
    {
      text: "About",
      href: "#",
      links: [
        { text: "About the Network", href: "/about/" },
        { text: "Mission & Values", href: "/mission/" },
        { text: "Meet the Trustees", href: "/team/" },
      ],
    },
    {
      text: "Bucket & Spade List",
      href: "#",
      links: bucketHeaderLinks, // Dynamically loaded Bucket & Spade links
    },
    { text: "Contact", href: "/contact/" },
  ],
  socialLinks: sharedSocialLinks,
};

const footerData = {
  links: [
    {
      links: [
        { text: "About the Network", href: "/about/" },
        { text: "Mission & Aims", href: "/mission/" },
        { text: "Meet the Trustees", href: "/team/" },
      ],
    },
    {
      links: [
        { text: "Upcoming Events", href: "/events/upcoming-events/" },
        {
          text: "Bucket & Spade List",
          href: latestWinners
            ? `/${latestWinners.full_slug}`
            : "/bucket-spade-list/top-ten-winners-2025/",
        },
        { text: "Contact", href: "/contact/" },
      ],
    },
  ],
  socialLinks: sharedSocialLinks,
  footNote: `&copy; ${gc.org_name ?? "Seaside Heritage Network"}. Registered Charity in England and Wales (Charity No. ${gc.charity_number ?? "1216037"}). All rights reserved.`,
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </Fragment>
  {
    Astro.url.pathname === "/" && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href="https://a.storyblok.com/f/251170/4298x3047/4582369638/penzanze-jubilee-pool.jpg/m/768x0/filters:quality(70):format(webp)"
        imagesrcset="https://a.storyblok.com/f/251170/4298x3047/4582369638/penzanze-jubilee-pool.jpg/m/400x0/filters:quality(70):format(webp) 400w, https://a.storyblok.com/f/251170/4298x3047/4582369638/penzanze-jubilee-pool.jpg/m/768x0/filters:quality(70):format(webp) 768w"
        imagesizes="(max-width: 1023px) 100vw, 60vw"
      />
    )
  }
  <slot name="header">
    <Header {...headerData} isSticky />
  </slot>
  <main id="main-content" tabindex="-1" class="flex-1">
    <slot />
    <Newsletter href={homeData?.story?.content?.signup_link?.url} />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
